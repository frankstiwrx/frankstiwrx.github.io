/* Empilhar nome + menu no mobile e ajustar altura reservada */
@media (max-width: 600px) {
  :root {
    --nav-h: 96px;
  } /* espaço maior no topo */
  .nav {
    flex-direction: column;
    align-items: center;
    gap: 8px;
    height: auto;
    padding: 10px 0;
  }
  .brand {
    justify-content: center;
    text-align: center;
  }
  .brand h1 {
    font-size: 18px;
    white-space: normal;
  }
  .menu {
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
  }
}
